# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}
# -------------------------------------------------------------------
# Service-to-service auth (Option A)
# -------------------------------------------------------------------
# Shared secret used by the caller (other team's backend) to access this API.
# Send as either:
#   - X-API-Key: <value>
#   - Authorization: Bearer <value>
SERVICE_API_KEY=

# Submission files (host paths under jobId/input and jobId/output)
SUBMISSIONS_PATH=/data/submissions
# Persistent job artifacts extracted from grader output (e.g. payload file).
# When running on Discovery with a shared RWO submissions PVC, set this to a
# directory inside the mounted submissions volume so both API + dispatcher see it.
# PAYLOADS_PATH=/data/submissions/payloads
# Max total upload size per job in bytes (default 52428800 = 50MB)
# MAX_SUBMISSION_UPLOAD_BYTES=52428800

# Session
SESSION_DRIVER=cookie

# Database configuration
DB_CONNECTION=pg
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=

#--------------------------------------------------------------------
# Kubernetes integration
#--------------------------------------------------------------------
K8S_NAMESPACE=default
K8S_SUBMISSIONS_ROOT=/var/lib/job-queue-scheduler/submissions
K8S_OUTPUT_ROOT=/var/lib/job-queue-scheduler/outputs
# USE_K8S_MOCK=true       # Set to true to skip real K8s (auto-set in development)
K8S_SUBMISSIONS_PVC=webcat-submissions-pvc

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
#CORS_ORIGIN=http://localhost:5173,http://localhost:3000